{
  "experiment": {
    "name": "v2_championship_tournament",
    "seed": 42,
    "output_dir": "output"
  },
  "llm": {
    "provider": "openrouter",
    "model_name": "stealth/ox-alpha",
    "temperature": 0.2,
    "max_retries": 3,
    "rate_limit": {
      "max_rpm": 30,
      "max_rpd": 1000
    }
  },
  "environment": {
    "error_rate": 0.0,
    "payoff_matrix": {
      "cooperate_cooperate": [3, 3],
      "defect_cooperate": [5, 0],
      "cooperate_defect": [0, 5],
      "defect_defect": [1, 1]
    }
  },
  "prompts": {
    "prompt_mode": "explicit_strategies",
    "modes_info": {
      "explicit_strategies": "Mode 1: The agent is told the exact candidate strategies in the pool and instructed to identify which one is active and counter it optimally.",
      "generic_archetypes": "Mode 2: The agent is told that opponents follow classical fixed heuristic strategies, and must discover the pattern and counter it without being given class names.",
      "blind_optimization": "Mode 3: The agent is given only IPD rules and payoff matrix, with zero mention of classical strategies."
    }
  },
  "training": {
    "enabled": true,
    "matches_per_strategy": 5,
    "rounds_per_match": 5,
    "strategies": [
      "AlwaysCooperate",
      "AlwaysDefect",
      "TitForTat",
      "SuspiciousTitForTat",
      "TitForTwoTats",
      "TatForTit",
      "Random",
      "Detective"
    ],
    "dreamer": {
      "enabled": true,
      "temperature": 0.2
    }
  },
  "evaluation": {
    "enabled": true,
    "matches_per_pairing": 5,
    "rounds_per_match": 5,
    "participants": [
      "LLMPlayer",
      "AlwaysCooperate",
      "AlwaysDefect",
      "TitForTat",
      "SuspiciousTitForTat",
      "TitForTwoTats",
      "TatForTit",
      "Random",
      "Detective"
    ],
    "scoring": {
      "win_match_points": 1.0,
      "draw_match_points": 0.5,
      "loss_match_points": 0.0
    }
  },
  "reporting": {
    "export_html": true,
    "export_markdown": true,
    "export_json": true,
    "terminal_style": "rich"
  }
}
